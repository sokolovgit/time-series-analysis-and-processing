MODULE := "lab1"

# Список доступних рецептів
default:
    @just --list

# Встановити залежності
sync:
    uv sync

# Запустити лабораторну роботу
run *ARGS:
    uv run python -m {{MODULE}} {{ARGS}}

# Лінт
lint:
    uv run ruff check .

# Відформатувати код і виправити те, що виправляється автоматично
fmt:
    uv run ruff format .
    uv run ruff check --fix .

# Перевірка без змін у файлах
check:
    uv run ruff format --check .
    uv run ruff check .

# Прибрати артефакти
clean:
    rm -rf output .ruff_cache
    find src -name __pycache__ -type d -exec rm -rf {} +
