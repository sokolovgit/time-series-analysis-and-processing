# Список доступних рецептів
default:
    @just --list

# Встановити залежності
sync:
    uv sync

# Запустити лабораторну роботу
run *ARGS:
    uv run python src/main.py {{ARGS}}

# Лінт
lint:
    uv run ruff check .

# Відформатувати код і виправити те, що виправляється автоматично
fmt:
    uv run ruff format .
    uv run ruff check --fix .

# Перевірка без змін у файлах
check:
    uv run ruff format --check .
    uv run ruff check .

# Прибрати кеші (згенеровані графіки лежать у docs/report/assets і трекаються)
clean:
    rm -rf .ruff_cache
    find src -name __pycache__ -type d -exec rm -rf {} +

# Відрендерити блок-схему звіту з блоку mermaid
diagram:
    uv run python scripts/render_diagram.py

# Згенерувати шаблон стилів ДСТУ для звіту
reference:
    uv run python scripts/make_reference_docx.py

# Зібрати звіт у .docx (ім'я для здачі: just report Прізвище_Ім'я_група_1.docx)
report *NAME:
    uv run python scripts/build_report.py {{NAME}}
