# ЛР 2 - статистичне навчання за Big Data Time Series

SKILL := env_var('HOME') / '.claude/skills/kpi-lab-report'
REPORT := '../docs/report/report.md'

_default:
    @just --list

# Прогін усіх етапів роботи
all *ARGS:
    uv run python src/main.py {{ ARGS }}

# Скопіювати графіки у звіт
sync-report:
    cp out/*.png ../docs/report/assets/
    @echo "графіки перенесено у docs/report/assets/"

# Перерахувати все і оновити звіт
rebuild: all sync-report

# Відрендерити блок-схему звіту з блоку mermaid
diagram:
    python3 {{ SKILL }}/scripts/render_diagram.py {{ REPORT }}

# Згенерувати шаблон стилів для звіту
reference:
    python3 {{ SKILL }}/scripts/make_reference_docx.py ../docs/report/reference.docx

# Зібрати звіт у .docx
report *NAME:
    python3 {{ SKILL }}/scripts/build_report.py {{ REPORT }} {{ NAME }}

# Прибрати згенероване
clean:
    rm -f out/*.png
